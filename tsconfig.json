{
    "compilerOptions": {
        "lib": ["DOM", "ES2021"],
        "module": "ESNext",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "useDefineForClassFields": true,
        "declaration": true,
        "outDir": "./build"
    },
    "include": ["src/**/*", "src/biblioteca/**/*", "src/biblioteca/button/**/*", "dev", "**/*.ts", "**/*.tsx", "**/*.d.ts", "types.d.ts"],
    "exclude": ["node_modules", "build"]
}
